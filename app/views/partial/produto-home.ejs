
<%
    var precoAtual       = produto.preco || 0;
    var precoComDesconto = produto.precoDesconto || null;
    var temDesconto      = precoComDesconto !== null && precoComDesconto > 0;
    var percentual       = 0;
    if (temDesconto && precoAtual > 0) {
        percentual = Math.round(((precoAtual - precoComDesconto) / precoAtual) * 100);
    }
    // [NOVO] formato brasileiro (39,90). Antes: toFixed(2) -> "39.90" (ponto), estranho para o público
    var moeda = function (v) { return 'R$ ' + Number(v).toFixed(2).replace('.', ','); };
    var avaliacoes = produto.avaliacoes || [];
    var temAvals   = avaliacoes.length > 0;
    var notaMedia  = 0;
    if (temAvals) {
        var soma = 0;
        avaliacoes.forEach(function(a) { soma += a.nota; });
        notaMedia = Math.round(soma / avaliacoes.length);
    }
%>
<article class="bloco-produto-home">
    <a href="/produto/<%= produto.id %>" class="link-produto-home">
        <img src="<%= produto.imagem %>"
             alt="<%= produto.nome %>"
             class="imagem-produto-home"
             loading="lazy">

        <%# [NOVO] wrapper só de layout: permite imagem à esquerda e texto à direita dentro da coluna %>
        <div class="info-produto-home">
            <h3 class="nome-produto-home"><%= produto.nome %></h3>

            <% if (temDesconto) { %>
                <p class="preco-container-home">
                    <%# [ALTERADO] rótulos só p/ leitor de tela: "riscado" não é lido; e o selo ganha o texto "de desconto" (linguagem clara) %>
                    <del class="preco-original-home"><span class="sr-only">Preço original: </span><%= moeda(precoAtual) %></del>
                    <strong class="preco-desconto-home"><span class="sr-only">Preço com desconto: </span><%= moeda(precoComDesconto) %></strong>
                    <span class="badge-desconto"><span class="percentual-home"><%= percentual %>% de desconto</span></span>
                </p>
            <% } else { %>
                <p class="preco-unico-home"><span class="sr-only">Preço: </span><%= moeda(precoAtual) %></p>
            <% } %>

            <p class="categoria-home"><%= produto.categoria %></p>

            <% if (produto.faixa_etaria) { %>
                <p class="faixa-etaria-home"><%= produto.faixa_etaria %></p>
            <% } %>

            <% if (temAvals) { %>
                <p class="estrelas-home" role="img" aria-label="Avaliação: <%= notaMedia %> de 5 estrelas">
                    <% for (var i = 1; i <= 5; i++) { %>
                        <img src="/imagens/estr<%= i <= notaMedia ? '' : 'v' %>.svg" alt="" class="estrela-home">
                    <% } %>
                    <%# [NOVO] nota por extenso (o aria-label do <p> já a anuncia, por isso aria-hidden aqui) %>
                    <span class="nota-texto-home" aria-hidden="true"><%= notaMedia %> de 5</span>
                </p>
            <% } %>
            <%# [NOVO] pista de que o cartão inteiro é um link (reconhecer em vez de adivinhar) %>
            <span class="ver-detalhes-home" aria-hidden="true">Ver detalhes ›</span>
        </div>
    </a>
</article>