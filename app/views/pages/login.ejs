<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/estilo.css">
    <link rel="stylesheet" href="/css/cad.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/notificacao.css">
    <link rel="stylesheet" href="/css/toggle-senha.css">
    <link rel="stylesheet" href="/css/validacao-frontend.css">
    <link rel="stylesheet" href="/css/ativacao.css">
    <link rel="stylesheet" href="/css/recuperar-senha.css"> <%# RECUPERAR SENHA: novo %>
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/acessibilidade-idosos.css">
    <script src="/js/acessibilidade-idosos.js"></script>
</head>
<body class="pagina-auth">
    <header>
        <a href="/home" class="icon-link" aria-label="+Saúde: voltar para a página inicial"><img class="icon" src="/imagens/logo-branco.svg" alt="Logo +Saúde"></a>
    </header>

    <%- include('../partial/ajuste-texto.ejs') %>

    <main>
        <section class="txt">
            <article class="title-group">
                <h1 class="tit">Login</h1>
            </article>
            
            <% if (typeof notificacao !== 'undefined' && notificacao) { %>
                <section class="secao-notificacao notif-sucesso" role="status" aria-live="polite">
                    <h2 class="notif-titulo"><%= notificacao.titulo %></h2>
                    <output class="notif-mensagem">
                        <%= notificacao.mensagem %>
                    </output>
                </section>
            <% } %>

            <% if (erro) { %>
                <article class="erro-login" role="alert">
                    <output class="mensagem-erro" aria-live="polite"><%= erro %></output>
                </article>
            <% } %>

            <% if (typeof emailPendente !== 'undefined' && emailPendente) { %>
                <nav class="login-ativacao" aria-label="Ativação de conta">
                    <a href="/reenviar-ativacao" class="link">Não recebeu o e-mail? Reenviar link de ativação</a>
                </nav>
            <% } %>

            <form method="POST" action="/login" novalidate aria-label="Formulário de login">
                <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '/home' %>">

                <fieldset>
                    <label for="email" class="rotulo-campo">E-mail</label>
                    <div class="campo">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="exemplo@dominio.com"
                            aria-describedby="email-error"
                            required>
                    </div>
                    <output class="error-message" id="email-error" role="alert" aria-live="polite"></output>
                </fieldset>

                <fieldset>
                    <label for="senha" class="rotulo-campo">Senha</label>
                    <div class="campo-senha">
                        <input
                            type="password"
                            id="senha"
                            name="senha"
                            placeholder="Sua senha"
                            aria-describedby="senha-error"
                            required>
                        <button type="button" class="btn-toggle-senha" aria-label="Mostrar senha" data-target="senha"></button>
                    </div>
                    <output class="error-message" id="senha-error" role="alert" aria-live="polite"></output>
                </fieldset>

                <%# >>> RECUPERAR SENHA (início) %>
                <nav class="login-recuperar" aria-label="Recuperação de senha">
                    <a href="/recuperar-senha" class="link">Esqueci minha senha</a>
                </nav>
                <%# <<< RECUPERAR SENHA (fim) %>

                <button id="btn-login" type="submit">Entrar</button>

                <p class="signup-prompt">
                    <a href="/cadastro" class="link">
                        Não tem uma conta?
                        <strong class="link2">Cadastre-se aqui</strong>
                    </a>
                </p>
            </form>
        </section>
    </main>

    <footer></footer>

    <script src="/js/validacao.js"></script>
    <script src="/js/toggle-senha.js"></script>

    <%- include('../partial/cookies.ejs') %>
    
</body>
</html>