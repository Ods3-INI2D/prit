<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/estilo.css">
    <link rel="stylesheet" href="/css/cad.css">
    <link rel="stylesheet" href="/css/toggle-senha.css">
    <link rel="stylesheet" href="/css/validacao-frontend.css">
    <link rel="stylesheet" href="/css/notificacao.css">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/mobile.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/acessibilidade-idosos.css">
    <script src="/js/acessibilidade-idosos.js"></script>
</head>
<body class="pagina-cadastro pagina-auth">
    <%
    var cssErro = { nome:"", nasc:"", cpf:"", ddd:"", tel:"", email:"", senhan:"", csenha:"", sexo:""};
    var msgErro = { nome:"", nasc:"", cpf:"", ddd:"", tel:"", email:"", senhan:"", csenha:"", sexo:""};

    if (erros) {
        listaErros.errors.forEach(function(itemErro) {
            if (itemErro.path === 'nome')   { cssErro.nome   = 'error'; msgErro.nome   = itemErro.msg; }
            if (itemErro.path === 'nasc')   { cssErro.nasc   = 'error'; msgErro.nasc   = itemErro.msg; }
            if (itemErro.path === 'cpf')    { cssErro.cpf    = 'error'; msgErro.cpf    = itemErro.msg; }
            if (itemErro.path === 'ddd')    { cssErro.ddd    = 'error'; msgErro.ddd    = itemErro.msg; }
            if (itemErro.path === 'tel')    { cssErro.tel    = 'error'; msgErro.tel    = itemErro.msg; }
            if (itemErro.path === 'email')  { cssErro.email  = 'error'; msgErro.email  = itemErro.msg; }
            if (itemErro.path === 'senhan') { cssErro.senhan = 'error'; msgErro.senhan = itemErro.msg; }
            if (itemErro.path === 'csenha') { cssErro.csenha = 'error'; msgErro.csenha = itemErro.msg; }
            if (itemErro.path === 'sexo') { cssErro.sexo = 'error'; msgErro.sexo = itemErro.msg; }
        });
    }
    %>

    <header>
        <a href="/home" class="icon-link" aria-label="+Saúde: voltar para a página inicial"><img class="icon" src="/imagens/logo-branco.svg" alt="Logo +Saúde"></a>
    </header>

    <%- include('../partial/ajuste-texto.ejs') %>

    <main>
        <section class="txt">
            <article class="title-group">
                <h1 class="tit">Cadastro</h1>
            </article>

            <% if (typeof erroGeral !== 'undefined' && erroGeral) { %>
                <article class="erro-login" role="alert">
                    <output class="mensagem-erro" aria-live="polite"><%= erroGeral %></output>
                </article>
            <% } %>

            <form method="POST" action="/cadastro" novalidate aria-label="Formulário de cadastro de usuário">

                <fieldset>
                    <label for="nome" class="rotulo-campo">Nome Completo</label>
                    <div class="campo">
                        <input
                            type="text"
                            id="nome"
                            name="nome"
                            placeholder="Seu nome completo"
                            value="<%= valores.nome %>"
                            class="<%= cssErro.nome %>"
                            aria-describedby="nome-error"
                            required>
                    </div>
                    <% if (msgErro.nome) { %>
                        <output class="error-message" id="nome-error" role="alert" aria-live="polite" style="display:block">
                            <%= msgErro.nome %>
                        </output>
                    <% } else { %>
                        <output class="error-message" id="nome-error" role="alert" aria-live="polite"></output>
                    <% } %>
                </fieldset>

                <fieldset>
                    <label for="nasc" class="rotulo-campo">Data de Nascimento</label>
                    <div class="campo">
                        <input
                            type="date"
                            id="nasc"
                            name="nasc"
                            value="<%= valores.nasc %>"
                            class="<%= cssErro.nasc %>"
                            aria-describedby="nasc-error"
                            required>
                    </div>
                    <% if (msgErro.nasc) { %>
                        <output class="error-message" id="nasc-error" role="alert" aria-live="polite" style="display:block">
                            <%= msgErro.nasc %>
                        </output>
                    <% } else { %>
                        <output class="error-message" id="nasc-error" role="alert" aria-live="polite"></output>
                    <% } %>
                </fieldset>

                <fieldset>
                    <label for="cpf" class="rotulo-campo">CPF</label>
                    <div class="campo">
                        <input
                            type="text"
                            id="cpf"
                            name="cpf"
                            placeholder="000.000.000-00"
                            value="<%= valores.cpf %>"
                            class="<%= cssErro.cpf %>"
                            maxlength="14"
                            aria-describedby="cpf-error"
                            required>
                    </div>
                    <% if (msgErro.cpf) { %>
                        <output class="error-message" id="cpf-error" role="alert" aria-live="polite" style="display:block">
                            <%= msgErro.cpf %>
                        </output>
                    <% } else { %>
                        <output class="error-message" id="cpf-error" role="alert" aria-live="polite"></output>
                    <% } %>
                </fieldset>

                <fieldset style="display:flex; gap:0.5rem;">
                    <section style="flex: 0 0 30%;">
                        <label for="ddd" class="rotulo-campo">DDD</label>
                        <div class="campo">
                            <input
                                type="text"
                                id="ddd"
                                name="ddd"
                                placeholder="11"
                                value="<%= valores.ddd %>"
                                class="<%= cssErro.ddd %>"
                                maxlength="2"
                                aria-describedby="ddd-error"
                                required>
                        </div>
                        <% if (msgErro.ddd) { %>
                            <output class="error-message" id="ddd-error" role="alert" aria-live="polite" style="display:block">
                                <%= msgErro.ddd %>
                            </output>
                        <% } else { %>
                            <output class="error-message" id="ddd-error" role="alert" aria-live="polite"></output>
                        <% } %>
                    </section>

                    <section style="flex: 1;">
                        <label for="tel" class="rotulo-campo">Telefone</label>
                        <div class="campo">
                            <input
                                type="tel"
                                id="tel"
                                name="tel"
                                placeholder="99999-9999"
                                value="<%= valores.tel %>"
                                class="<%= cssErro.tel %>"
                                maxlength="10"
                                aria-describedby="tel-error"
                                required>
                        </div>
                        <% if (msgErro.tel) { %>
                            <output class="error-message" id="tel-error" role="alert" aria-live="polite" style="display:block">
                                <%= msgErro.tel %>
                            </output>
                        <% } else { %>
                            <output class="error-message" id="tel-error" role="alert" aria-live="polite"></output>
                        <% } %>
                    </section>
                </fieldset>
                
                <fieldset>
                    <legend>Sexo</legend>
                    <section class="grupo-opcoes">
                    <label class="opcao-radio" for="sexo-masc">
                        <input type="radio" id="sexo-masc" name="sexo" value="masculino"
                            required aria-required="true"
                            <%= valores.sexo === 'masculino' ? 'checked' : '' %>>
                        Masculino
                    </label>
                    <label class="opcao-radio" for="sexo-fem">
                        <input type="radio" id="sexo-fem" name="sexo" value="feminino"
                            <%= valores.sexo === 'feminino' ? 'checked' : '' %>>
                        Feminino
                    </label>
                    <label class="opcao-radio" for="sexo-nd">
                        <input type="radio" id="sexo-nd" name="sexo" value="prefiro-nao-dizer"
                            <%= valores.sexo === 'prefiro-nao-dizer' ? 'checked' : '' %>>
                        Prefiro Não Dizer
                    </label>
                    </section>
                    <% if (msgErro.sexo) { %>
                        <output class="error-message" id="sexo-error" role="alert" aria-live="polite" style="display:block">
                            <%= msgErro.sexo %>
                        </output>
                    <% } else { %>
                        <output class="error-message" id="sexo-error" role="alert" aria-live="polite"></output>
                    <% } %>
                </fieldset>

                <fieldset>
                    <label for="email" class="rotulo-campo">E-mail</label>
                    <div class="campo">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="exemplo@dominio.com"
                            value="<%= valores.email %>"
                            class="<%= cssErro.email %>"
                            aria-describedby="email-error"
                            required>
                    </div>
                    <% if (msgErro.email) { %>
                        <output class="error-message" id="email-error" role="alert" aria-live="polite" style="display:block">
                            <%= msgErro.email %>
                        </output>
                    <% } else { %>
                        <output class="error-message" id="email-error" role="alert" aria-live="polite"></output>
                    <% } %>
                </fieldset>

                <fieldset>
                    <label for="senhan" class="rotulo-campo">Senha</label>
                    <div class="campo-senha">
                        <input
                            type="password"
                            id="senhan"
                            name="senhan"
                            placeholder="Sua senha"
                            value="<%= valores.senhan %>"
                            class="<%= cssErro.senhan %>"
                            aria-describedby="senhan-error senhan-dica"
                            required>
                        <button type="button" class="btn-toggle-senha" aria-label="Mostrar senha" data-target="senhan"></button>
                    </div>
                    <output id="senhan-dica" class="error-message dica-campo">
                        Use de 6 a 20 caracteres, com uma letra maiúscula, um número e um símbolo (! @ # $ % ^ & *).
                    </output>
                    <% if (msgErro.senhan) { %>
                        <output class="error-message" id="senhan-error" role="alert" aria-live="polite" style="display:block">
                            <%= msgErro.senhan %>
                        </output>
                    <% } else { %>
                        <output class="error-message" id="senhan-error" role="alert" aria-live="polite"></output>
                    <% } %>
                </fieldset>

                <fieldset>
                    <label for="senha" class="rotulo-campo">Confirmar Senha</label>
                    <div class="campo-senha">
                        <input
                            type="password"
                            id="senha"
                            name="csenha"
                            placeholder="Confirme sua senha"
                            value="<%= valores.csenha %>"
                            class="<%= cssErro.csenha %>"
                            aria-describedby="csenha-error"
                            required>
                        <button type="button" class="btn-toggle-senha" aria-label="Mostrar senha" data-target="senha"></button>
                    </div>
                    <% if (msgErro.csenha) { %>
                        <output class="error-message" id="csenha-error" role="alert" aria-live="polite" style="display:block">
                            <%= msgErro.csenha %>
                        </output>
                    <% } else { %>
                        <output class="error-message" id="csenha-error" role="alert" aria-live="polite"></output>
                    <% } %>
                </fieldset>

                <button id="btn" type="submit">Cadastrar</button>

                <p class="signup-prompt">
                    <a href="/login" class="link">
                        Já tem uma conta?
                        <strong class="link2">Entre aqui</strong>
                    </a>
                </p>
            </form>
        </section>
    </main>

    <footer>
        <%- include('../partial/cookies.ejs') %>
    </footer>

    <script src="/js/validacao.js"></script>
    <script src="/js/toggle-senha.js"></script>

</body>
</html>
