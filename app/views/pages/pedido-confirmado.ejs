<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedido Confirmado - +Saúde</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/grid.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/checkout.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/semantica-fix.css">
    <script src="/js/theme.js"></script>
</head>
<body>
    <%
        var pedidoAprovado = status_pedido === 'aprovado';
        var pedidoCancelado = status_pedido === 'cancelado';
    %>
    <header>
        <%- include('../partial/grid.ejs') %>
    </header>

    <main>
        <article class="confirmacao-container">

            <output class="icone-sucesso" role="img" aria-label="<%= pedidoAprovado ? 'Pagamento aprovado' : pedidoCancelado ? 'Pagamento não aprovado' : 'Pagamento pendente' %>">
                <%= pedidoAprovado ? '✅' : pedidoCancelado ? '⚠️' : '⏳' %>
            </output>

            <h1 class="titulo-confirmacao">
                <%= pedidoAprovado ? 'Pagamento aprovado!' : pedidoCancelado ? 'Pagamento não aprovado' : 'Aguardando pagamento' %>
            </h1>

            <output class="subtitulo-confirmacao">
                <% if (pedidoAprovado) { %>
                    Obrigado pela sua compra! Seu pedido está sendo processado.
                <% } else if (pedidoCancelado) { %>
                    O pagamento não foi aprovado. Consulte as opções disponíveis na sua conta.
                <% } else { %>
                    Seu pedido foi criado. A confirmação será atualizada após o Mercado Pago processar o pagamento.
                <% } %>
            </output>

            <section class="numero-pedido" aria-label="Número do pedido">
                <output class="numero-pedido-label">Número do seu pedido</output>
                <output class="numero-pedido-valor">#<%= id_pedido %></output>
            </section>

            <% if (forma_pagamento_label === 'PIX' && pix_qr_code && status_pedido === 'pendente') { %>
                <section aria-labelledby="titulo-pagamento-pix"
                         style="background-color:#2a2a2a;border-radius:0.625rem;padding:1.25rem;margin-bottom:1.75rem;">
                    <h2 id="titulo-pagamento-pix"
                        style="font-size:1rem;font-weight:600;color:#4da6ff;margin-bottom:0.75rem;">
                        Pague com PIX
                    </h2>
                    <p style="font-size:0.9rem;color:#d9d9d9;margin-bottom:1rem;">
                        Escaneie o QR Code no aplicativo do seu banco ou copie o código PIX.
                    </p>
                    <% if (pix_qr_code_base64) { %>
                        <img src="data:image/png;base64,<%= pix_qr_code_base64 %>"
                             alt="QR Code PIX do pedido"
                             style="display:block;width: min(100%, 16rem);height:auto;margin:0 auto 1rem;background:#fff;padding:0.5rem;border-radius:0.5rem;">
                    <% } %>
                    <label for="codigo-pix"
                           style="display:block;font-size:0.875rem;color:#d9d9d9;margin-bottom:0.5rem;">
                        PIX copia e cola
                    </label>
                    <textarea id="codigo-pix" readonly rows="4"
                              style="display:block;width:100%;box-sizing:border-box;margin-bottom:0.75rem;"><%= pix_qr_code %></textarea>
                    <button type="button" id="copiar-pix"
                            style="padding:0.7rem 1rem;border:0;border-radius:0.4rem;background:#1683ff;color:#fff;cursor:pointer;">
                        Copiar código PIX
                    </button>
                    <output id="mensagem-copia-pix" aria-live="polite"></output>
                    <% if (pix_ticket_url) { %>
                        <p style="margin-top:0.75rem;">
                            <a href="<%= pix_ticket_url %>" target="_blank" rel="noopener noreferrer">
                                Abrir pagamento PIX no Mercado Pago
                            </a>
                        </p>
                    <% } %>
                </section>
            <% } %>

            <section aria-labelledby="titulo-resumo-pedido">
                <h2 id="titulo-resumo-pedido"
                    style="font-size:1.1rem;font-weight:600;color:#4da6ff;margin-bottom:1rem;text-align:center;">
                    Resumo da Compra
                </h2>

                <table style="width:100%;border-collapse:collapse;margin-bottom:1.5rem;font-size:0.9rem;">
                    <caption style="display:none;">Detalhes do pedido confirmado</caption>
                    <thead>
                        <tr style="border-bottom:0.0625rem solid #404040;">
                            <th scope="col"
                                style="text-align:left;padding:0.5rem 0;color:#888;font-weight:500;">
                                Produto
                            </th>
                            <th scope="col"
                                style="text-align:center;padding:0.5rem 0;color:#888;font-weight:500;">
                                Qtd
                            </th>
                            <th scope="col"
                                style="text-align:right;padding:0.5rem 0;color:#888;font-weight:500;">
                                Valor
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <% itens.forEach(function(item) {
                            var precoUnit = parseFloat(item.preco_unit) || 0;
                            var qtd       = parseInt(item.quantidade)   || 1;
                            var subtotal  = precoUnit * qtd;
                        %>
                            <tr style="border-bottom:0.0625rem solid rgba(255,255,255,0.06);">
                                <td style="padding:0.625rem 0;color:white;">
                                    <%= item.nome %>
                                </td>
                                <td style="text-align:center;padding:0.625rem 0;color:#d9d9d9;">
                                    <%= qtd %>
                                </td>
                                <td style="text-align:right;padding:0.625rem 0;color:#4da6ff;font-weight:600;">
                                    R$ <%= subtotal.toFixed(2) %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2"
                                style="padding:0.75rem 0;font-weight:700;color:white;
                                       border-top:0.0625rem solid #404040;">
                                Total
                            </td>
                            <td style="text-align:right;padding:0.75rem 0;font-weight:700;
                                       color:#4da6ff;font-size:1.05rem;
                                       border-top:0.0625rem solid #404040;">
                                R$ <%= parseFloat(valor_total).toFixed(2) %>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </section>

            <section aria-labelledby="titulo-info-entrega"
                     style="background-color:#2a2a2a;border-radius:0.625rem;
                            padding:1.25rem;margin-bottom:1.75rem;text-align:left;">
                <h2 id="titulo-info-entrega"
                    style="font-size:1rem;font-weight:600;color:#4da6ff;margin-bottom:0.75rem;">
                    Informações de Entrega
                </h2>

                <dl>
                    <dt style="display:none;">Endereço</dt>
                    <dd style="font-size:0.875rem;color:#d9d9d9;margin-bottom:0.4rem;">
                        📍 <%= endereco %>
                    </dd>

                    <dt style="display:none;">Forma de Pagamento</dt>
                    <dd style="font-size:0.875rem;color:#d9d9d9;margin-bottom:0.4rem;">
                        💳 <%= forma_pagamento_label %>
                    </dd>

                    <dt style="display:none;">Prazo estimado</dt>
                    <dd style="font-size:0.8125rem;color:#888;">
                        🚚 Prazo estimado: 5 a 10 dias úteis após confirmação do pagamento
                    </dd>
                </dl>
            </section>

            <nav class="acoes-confirmacao" aria-label="Ações pós-compra">
                <a href="/home" class="btn-voltar-home">Continuar Comprando</a>
                <a href="/usuario"
                   class="btn-voltar-home"
                   style="background-color:#2a2a2a;border:0.125rem solid #4da6ff;color:#4da6ff;">
                    Minha Conta
                </a>
            </nav>

        </article>
    </main>

    <%- include('../partial/footer.ejs') %>
    <script>
        (function() {
            var botao = document.getElementById('copiar-pix');
            var codigo = document.getElementById('codigo-pix');
            var mensagem = document.getElementById('mensagem-copia-pix');
            if (!botao || !codigo || !mensagem) return;

            botao.addEventListener('click', function() {
                codigo.select();
                codigo.setSelectionRange(0, codigo.value.length);
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(codigo.value).then(function() {
                        mensagem.textContent = 'Código PIX copiado.';
                    }).catch(function() {
                        mensagem.textContent = 'Não foi possível copiar. Selecione e copie o código manualmente.';
                    });
                    return;
                }
                mensagem.textContent = document.execCommand('copy')
                    ? 'Código PIX copiado.'
                    : 'Não foi possível copiar. Selecione e copie o código manualmente.';
            });
        })();
    </script>
</body>
</html>