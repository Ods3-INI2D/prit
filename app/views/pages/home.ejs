<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/estilo.css">
    <link rel="stylesheet" href="/css/grid.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/bloco.css">
    <link rel="stylesheet" href="/css/carousel.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/notificacao.css">
    <script src="/js/theme.js"></script>
</head>
<body>
    <header>
        <%- include('../partial/grid.ejs') %>
    </header>

    <main>
        <% if (typeof notificacao !== 'undefined' && notificacao) { %>
            <section class="secao-notificacao notif-<%= notificacao.tipo %>" role="status" aria-live="polite">
                <h2 class="notif-titulo"><%= notificacao.titulo %></h2>
                <p class="notif-mensagem"><%= notificacao.mensagem %></p>
            </section>
        <% } %>

        <section class="carousel-container" aria-label="Carrossel de destaques">
            <% if(banners && banners.length > 0) { %>
                <% banners.forEach(function(banner, index) { %>
                    <figure class="carousel-slide <%= index === 0 ? 'active' : '' %>"
                            aria-hidden="<%= index === 0 ? 'false' : 'true' %>">
                        <a href="<%= banner.link || '/home' %>" class="carousel-link" aria-label="<%= banner.legenda %>">
                            <img src="<%= banner.imagem %>" alt="<%= banner.legenda %>">
                            <figcaption class="carousel-caption"><%= banner.legenda %></figcaption>
                        </a>
                    </figure>
                <% }); %>
            <% } %>

            <nav class="carousel-controls" aria-label="Controles do carrossel">
                <button class="carousel-btn prev" aria-label="Slide anterior">◀</button>
                <button class="carousel-btn next" aria-label="Próximo slide">▶</button>
            </nav>

            <nav class="carousel-indicators" aria-label="Indicadores do carrossel">
                <% if(banners && banners.length > 0) { %>
                    <% banners.forEach(function(banner, index) { %>
                        <button class="indicator <%= index === 0 ? 'active' : '' %>"
                                aria-label="Ir para slide <%= index + 1 %>"
                                data-slide="<%= index %>"></button>
                    <% }); %>
                <% } %>
            </nav>
        </section>

        <%#
            [ALTERADO] Todo o bloco de produtos abaixo foi substituído.
            Antes: 3 seções separadas (Para Você / Descontos / Categorias), cada uma com grid de
            produtos e o cartão de produto copiado 3x.
            Agora: UM carrossel horizontal; cada coluna = uma categoria, com no máximo 4 produtos.
        %>
        <%
            var LIMITE_POR_COLUNA = 4;
            var listaProdutos     = (typeof produtos !== 'undefined' && produtos) ? produtos : [];
            var colunas           = [];

            // Coluna "Para Você" (somente usuário logado que não é admin)
            if (typeof usuario !== 'undefined' && usuario && !isAdmin) {
                var paraVoce = listaProdutos.slice(0, LIMITE_POR_COLUNA);
                if (paraVoce.length > 0) {
                    colunas.push({ id: 'para-voce', titulo: 'Para Você', link: null, itens: paraVoce });
                }
            }

            // Coluna "Descontos"
            var comDesconto = listaProdutos.filter(function(p) {
                return p.precoDesconto !== null && p.precoDesconto > 0;
            });
            if (comDesconto.length > 0) {
                colunas.push({ id: 'descontos', titulo: 'Descontos', link: '/home',
                               itens: comDesconto.slice(0, LIMITE_POR_COLUNA) });
            }

            // Uma coluna por categoria (categorias sem produtos são ignoradas)
            if (typeof categorias !== 'undefined' && categorias && categorias.length > 0) {
                categorias.forEach(function(categoria) {
                    var daCategoria = listaProdutos.filter(function(p) {
                        if (!p.categoria) return false;
                        var nomes = p.categoria.split(', ').map(function(n) { return n.trim(); });
                        return nomes.indexOf(categoria.nome) !== -1;
                    });
                    if (daCategoria.length === 0) return;
                    colunas.push({ id: 'cat-' + categoria.id_categoria, titulo: categoria.nome,
                                   link: '/categoria/' + categoria.slug,
                                   itens: daCategoria.slice(0, LIMITE_POR_COLUNA) });
                });
            }
        %>

        <% if (colunas.length > 0) { %>
            <section class="carrossel-produtos" aria-label="Produtos por categoria">
                <nav class="carrossel-produtos-controles" aria-label="Controles do carrossel de produtos">
                    <button type="button" class="carrossel-produtos-btn" data-direcao="-1"
                            aria-controls="trilho-produtos" aria-label="Ver categoria anterior">◀</button>
                    <button type="button" class="carrossel-produtos-btn" data-direcao="1"
                            aria-controls="trilho-produtos" aria-label="Ver próxima categoria">▶</button>
                </nav>

                <ul class="carrossel-produtos-trilho" id="trilho-produtos" tabindex="0"
                    aria-label="Categorias de produtos, role para o lado para ver mais">
                    <% colunas.forEach(function(coluna) { %>
                        <li class="coluna-produtos">
                            <header class="header-categoria">
                                <h2 id="titulo-<%= coluna.id %>" class="titulo-categoria"><%= coluna.titulo %></h2>
                                <% if (coluna.link) { %>
                                    <a href="<%= coluna.link %>" class="link-ver-mais">
                                        <span>Ver mais</span>
                                        <img src="/imagens/setal.svg" alt="" class="seta-ver-mais">
                                    </a>
                                <% } %>
                            </header>

                            <ul class="lista-produtos-coluna" aria-labelledby="titulo-<%= coluna.id %>">
                                <% coluna.itens.forEach(function(produto) { %>
                                    <li>
                                        <%- include('../partial/produto-home.ejs', { produto: produto }) %>
                                    </li>
                                <% }); %>
                            </ul>
                        </li>
                    <% }); %>
                </ul>
            </section>
        <% } else { %>
            <article class="sem-produtos">
                <p class="mensagem-vazio">Nenhum produto disponível no momento.</p>
                <% if(isAdmin) { %>
                    <a href="/admin" class="btn-admin">Gerenciar o Site</a>
                <% } %>
            </article>
        <% } %>
    </main>

    <%- include('../partial/footer.ejs') %>

    <%# [NOVO] script do carrossel de produtos %>
    <script src="/js/carrossel-produtos.js" defer></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var slides     = document.querySelectorAll('.carousel-slide');
            var prevBtn    = document.querySelector('.carousel-btn.prev');
            var nextBtn    = document.querySelector('.carousel-btn.next');
            var indicators = document.querySelectorAll('.indicator');
            var currentSlide = 0;
            var autoPlayInterval;

            if(slides.length === 0) return;

            function showSlide(n) {
                slides.forEach(function(s) {
                    s.classList.remove('active');
                    s.setAttribute('aria-hidden', 'true');
                });
                indicators.forEach(function(ind) { ind.classList.remove('active'); });

                currentSlide = (n + slides.length) % slides.length;

                slides[currentSlide].classList.add('active');
                slides[currentSlide].setAttribute('aria-hidden', 'false');
                if(indicators[currentSlide]) indicators[currentSlide].classList.add('active');
            }

            function startAutoPlay() { autoPlayInterval = setInterval(function() { showSlide(currentSlide + 1); }, 5000); }
            function stopAutoPlay()  { clearInterval(autoPlayInterval); }

            if(prevBtn) prevBtn.addEventListener('click', function(e) { e.stopPropagation(); showSlide(currentSlide - 1); stopAutoPlay(); startAutoPlay(); });
            if(nextBtn) nextBtn.addEventListener('click', function(e) { e.stopPropagation(); showSlide(currentSlide + 1); stopAutoPlay(); startAutoPlay(); });

            indicators.forEach(function(ind) {
                ind.addEventListener('click', function(e) {
                    e.stopPropagation();
                    showSlide(parseInt(this.getAttribute('data-slide')));
                    stopAutoPlay();
                    startAutoPlay();
                });
            });

            startAutoPlay();

            var container = document.querySelector('.carousel-container');
            if(container) {
                container.addEventListener('mouseenter', stopAutoPlay);
                container.addEventListener('mouseleave', startAutoPlay);
            }
        });
    </script>
</body>
</html>