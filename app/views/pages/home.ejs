<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/estilo.css">
    <link rel="stylesheet" href="/css/grid.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/bloco.css">
    <%# [ALTERADO] carousel.css (carrossel grande) substituído por banners.css (banners pequenos) %>
    <link rel="stylesheet" href="/css/banners.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/notificacao.css">
    <script src="/js/theme.js"></script>
</head>
<body>
    <header>
        <%- include('../partial/grid.ejs') %>
    </header>

    <main>
        <% if (typeof notificacao !== 'undefined' && notificacao) { %>
            <section class="secao-notificacao notif-<%= notificacao.tipo %>" role="status" aria-live="polite">
                <h2 class="notif-titulo"><%= notificacao.titulo %></h2>
                <p class="notif-mensagem"><%= notificacao.mensagem %></p>
            </section>
        <% } %>

        <%#
            [ALTERADO] Antes: carrossel grande (1 slide por vez, com autoplay, setas e indicadores).
            Agora: faixa com banners pequenos. Desktop = 3 lado a lado; mobile = 2 lado a lado
            (o 3º é ocultado só por CSS, ver banners.css). Mesma lógica da faixa "Para Você":
            a lista já chega ordenada por relevância do router e aqui só se pega os primeiros.
        %>
        <%
            var LIMITE_BANNERS = 3;   // [NOVO] equivale ao LIMITE_POR_CARROSSEL da faixa "Para Você"
            var listaBanners   = (typeof banners !== 'undefined' && banners) ? banners : [];
            var bannersExibidos = listaBanners.slice(0, LIMITE_BANNERS);
        %>

        <% if (bannersExibidos.length > 0) { %>
            <section class="banners-destaque" aria-label="Destaques">
                <ul class="banners-lista">
                    <% bannersExibidos.forEach(function(banner) { %>
                        <li class="banner-item">
                            <%# a legenda (figcaption) já nomeia o link, por isso o alt da imagem fica vazio %>
                            <a href="<%= banner.link || '/home' %>" class="banner-link">
                                <figure class="banner-figura">
                                    <img src="<%= banner.imagem %>" alt="" class="banner-imagem" loading="lazy">
                                    <figcaption class="banner-legenda"><%= banner.legenda %></figcaption>
                                </figure>
                            </a>
                        </li>
                    <% }); %>
                </ul>
            </section>
        <% } %>

        <%#
            [ALTERADO] Antes: UM carrossel horizontal em que cada coluna = uma categoria (produtos empilhados).
            Agora: cada categoria é uma FAIXA horizontal (<section>) com o PRÓPRIO carrossel de produtos.
        %>
        <%
            var LIMITE_POR_CARROSSEL = 12;   // [ALTERADO] era LIMITE_POR_COLUNA = 4; carrossel precisa de mais itens
            var listaProdutos        = (typeof produtos !== 'undefined' && produtos) ? produtos : [];
            var faixas               = [];   // [ALTERADO] era "colunas"

            // Faixa "Para Você" (somente usuário logado que não é admin)
            if (typeof usuario !== 'undefined' && usuario && !isAdmin) {
                var paraVoce = listaProdutos.slice(0, LIMITE_POR_CARROSSEL);
                if (paraVoce.length > 0) {
                    faixas.push({ id: 'para-voce', titulo: 'Para Você', link: null, itens: paraVoce });
                }
            }

            // Faixa "Descontos"
            var comDesconto = listaProdutos.filter(function(p) {
                return p.precoDesconto !== null && p.precoDesconto > 0;
            });
            if (comDesconto.length > 0) {
                faixas.push({ id: 'descontos', titulo: 'Descontos', link: '/home',
                              itens: comDesconto.slice(0, LIMITE_POR_CARROSSEL) });
            }

            // Uma faixa por categoria (categorias sem produtos são ignoradas)
            if (typeof categorias !== 'undefined' && categorias && categorias.length > 0) {
                categorias.forEach(function(categoria) {
                    var daCategoria = listaProdutos.filter(function(p) {
                        if (!p.categoria) return false;
                        var nomes = p.categoria.split(', ').map(function(n) { return n.trim(); });
                        return nomes.indexOf(categoria.nome) !== -1;
                    });
                    if (daCategoria.length === 0) return;
                    faixas.push({ id: 'cat-' + categoria.id_categoria, titulo: categoria.nome,
                                  link: '/categoria/' + categoria.slug,
                                  itens: daCategoria.slice(0, LIMITE_POR_CARROSSEL) });
                });
            }
        %>

        <% if (faixas.length > 0) { %>
            <%# [ALTERADO] um <section> por categoria; data-carrossel é o gancho do JS (um carrossel independente por faixa) %>
            <% faixas.forEach(function(faixa) { %>
                <section class="carrossel-produtos" data-carrossel aria-labelledby="titulo-<%= faixa.id %>">
                    <header class="header-categoria">
                        <h2 id="titulo-<%= faixa.id %>" class="titulo-categoria"><%= faixa.titulo %></h2>

                        <% if (faixa.link) { %>
                            <a href="<%= faixa.link %>" class="link-ver-mais">
                                <span>Ver mais</span>
                                <img src="/imagens/setal.svg" alt="" class="seta-ver-mais">
                            </a>
                        <% } %>

                    </header>

                    <%# [NOVO] palco: agrupa os botões e o trilho para posicionar ◀ ▶ nas extremidades da faixa %>
                    <div class="carrossel-produtos-palco">
                        <%# [ALTERADO] botões saíram do cabeçalho: ◀ na extremidade esquerda, ▶ na direita (ver ordem do DOM = ordem de tabulação) %>
                        <button type="button" class="carrossel-produtos-btn carrossel-produtos-btn-ant" data-direcao="-1"
                                aria-controls="trilho-<%= faixa.id %>"
                                aria-label="Produtos anteriores de <%= faixa.titulo %>">◀</button>

                        <ul class="carrossel-produtos-trilho" id="trilho-<%= faixa.id %>" tabindex="0"
                            aria-labelledby="titulo-<%= faixa.id %>">
                            <% faixa.itens.forEach(function(produto) { %>
                                <li class="item-carrossel">
                                    <%- include('../partial/produto-home.ejs', { produto: produto }) %>
                                </li>
                            <% }); %>
                        </ul>

                        <button type="button" class="carrossel-produtos-btn carrossel-produtos-btn-prox" data-direcao="1"
                                aria-controls="trilho-<%= faixa.id %>"
                                aria-label="Próximos produtos de <%= faixa.titulo %>">▶</button>
                    </div>
                </section>
            <% }); %>
        <% } else { %>
            <article class="sem-produtos">
                <p class="mensagem-vazio">Nenhum produto disponível no momento.</p>
                <% if(isAdmin) { %>
                    <a href="/admin" class="btn-admin">Gerenciar o Site</a>
                <% } %>
            </article>
        <% } %>
    </main>

    <%- include('../partial/footer.ejs') %>

    <%# [NOVO] script do carrossel de produtos %>
    <script src="/js/carrossel-produtos.js" defer></script>

    <%# [ALTERADO] removido o <script> inline do carrossel grande (slides/autoplay): não há mais carrossel de banners %>
</body>
</html>