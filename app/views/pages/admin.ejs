<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrador - Painel de Controle</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/admin-extended.css">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
</head>
<body>
    <%
        var isoData = function (valor) {
            var d = new Date(valor);
            return isNaN(d) ? '' : d.toISOString().slice(0, 10);
        };
    %>
    <header>
        <img src="/imagens/logo-branco.svg" alt="Logotipo da Farmácia" class="logo">
        <h1 class="titulo">Painel Administrativo</h1>
        <button type="button" class="theme-toggle">
            <img src="/imagens/lua-branca.svg" alt="" aria-hidden="true" class="theme-icon">
            <span class="theme-text">Tema Escuro</span>
        </button>
    </header>
 
    <main>

        <% if (sucesso && mensagensSucesso[sucesso]) { %>
            <output class="mensagem-sucesso" role="status" aria-live="polite">
                <%= mensagensSucesso[sucesso] %>
            </output>
        <% } %>

        <% if (erro && erro === 'funcao_restrita') { %>
            <output class="mensagem-info" role="alert" aria-live="assertive">
                ⚠️ Esta funcionalidade está restrita a usuários clientes. Como administrador, você não pode acessar o carrinho ou avaliar produtos.
            </output>
        <% } else if (erro && mensagensErro[erro]) { %>
            <output class="mensagem-erro" role="alert" aria-live="assertive">
                <%= mensagensErro[erro] %>
            </output>
        <% } %>

        <section class="estatisticas" aria-labelledby="titulo-estatisticas">
            <h2 id="titulo-estatisticas" class="subtitulo">Estatísticas do Site</h2>
            <section class="estatisticas-grid">
                <article class="card-stats">
                    <h3 class="stat-titulo">Total de Produtos</h3>
                    <output class="stat-valor"><%= totalProdutos %></output>
                </article>
                <article class="card-stats">
                    <h3 class="stat-titulo">Total de Usuários</h3>
                    <output class="stat-valor"><%= usuarios.length %></output>
                </article>
                <article class="card-stats">
                    <h3 class="stat-titulo">Total de Categorias</h3>
                    <output class="stat-valor"><%= categorias.length %></output>
                </article>
            </section>
        </section>

        <section class="tabs-container">
            <div class="tabs-header" role="tablist" aria-label="Seções do painel">
                <button class="tab-button active" data-tab="adicionar"   role="tab" aria-selected="true"  aria-controls="tab-adicionar">Adicionar Produto</button>
                <button class="tab-button"         data-tab="produtos"   role="tab" aria-selected="false" aria-controls="tab-produtos">Produtos</button>
                <button class="tab-button"         data-tab="categorias" role="tab" aria-selected="false" aria-controls="tab-categorias">Categorias</button>
                <button class="tab-button"         data-tab="usuarios"   role="tab" aria-selected="false" aria-controls="tab-usuarios">Usuários</button>
                <button class="tab-button"         data-tab="banners"    role="tab" aria-selected="false" aria-controls="tab-banners">Banners</button>
            </div>

            <%# adicionar produto%>
            <section class="tab-content active" id="tab-adicionar" role="tabpanel" aria-labelledby="titulo-adicionar">
                <section class="adicionar-produto">
                    <h2 id="titulo-adicionar" class="subtitulo">Adicionar Novo Produto</h2>
                    
                    <form method="POST" action="/admin/adicionar-produto" class="form-produto" enctype="multipart/form-data" aria-label="Formulário de cadastro de produto">
                        <fieldset>
                            <legend class="label-titulo">Nome do Produto <span class="obrigatorio" aria-hidden="true">*</span></legend>
                            <label for="nome-add">
                                <input type="text" id="nome-add" name="nome" placeholder="Digite o nome do produto" required aria-required="true">
                            </label>
                        </fieldset>

                        <fieldset>
                            <legend class="label-titulo">Preço (R$) <span class="obrigatorio" aria-hidden="true">*</span></legend>
                            <label for="preco-add">
                                <input type="number" id="preco-add" name="preco" placeholder="0.00" step="0.01" min="0" required aria-required="true">
                            </label>
                        </fieldset>

                        <fieldset>
                            <legend class="label-titulo">Preço com Desconto (opcional)</legend>
                            <label for="precoDesconto-add">
                                <input type="number" id="precoDesconto-add" name="precoDesconto" placeholder="0.00" step="0.01" min="0">
                            </label>
                        </fieldset>

                        <fieldset>
                            <legend class="label-titulo">Categorias <span class="obrigatorio" aria-hidden="true">*</span> (selecione uma ou mais)</legend>
                            <% if (categorias && categorias.length > 0) { %>
                                <section class="categorias-grupo-admin">
                                    <% categorias.forEach(function(cat) { %>
                                        <label class="checkbox-item-admin">
                                            <input type="checkbox"
                                                   name="categorias"
                                                   value="<%= cat.id_categoria %>"
                                                   class="checkbox-input-admin">
                                            <span class="checkbox-label-admin"><%= cat.nome %></span>
                                        </label>
                                    <% }); %>
                                </section>
                            <% } else { %>
                                <output class="mensagem-info">Nenhuma categoria cadastrada. Crie categorias na aba "Categorias".</output>
                            <% } %>
                        </fieldset>

                        <fieldset>
                            <legend class="label-titulo">Status do Produto <span class="obrigatorio" aria-hidden="true">*</span></legend>
                            <label for="status-add">
                                <select id="status-add" name="status" required aria-required="true">
                                    <option value="em-estoque">Em Estoque</option>
                                    <option value="fora-de-estoque">Fora de Estoque</option>
                                </select>
                            </label>
                        </fieldset>

                        <fieldset>
                            <legend class="label-titulo">Faixa Etária Recomendada</legend>
                            <label for="faixa-etaria-add">
                                <select id="faixa-etaria-add" name="faixa_etaria">
                                    <option value="">Todas as idades</option>
                                    <option value="40+">A partir de 40 anos</option>
                                    <option value="45+">A partir de 45 anos</option>
                                    <option value="50+">A partir de 50 anos</option>
                                    <option value="55+">A partir de 55 anos</option>
                                    <option value="60+">A partir de 60 anos</option>
                                    <option value="65+">A partir de 65 anos</option>
                                    <option value="70+">A partir de 70 anos</option>
                                    <option value="75+">A partir de 75 anos</option>
                                    <option value="80+">80 anos ou mais</option>
                                </select>
                            </label>
                        </fieldset>

                        <fieldset>
                            <legend class="label-titulo">Público-Alvo (Sexo)</legend>
                            <label for="sexo-add">
                                <select id="sexo-add" name="sexo">
                                    <option value="masculino">Masculino</option>
                                    <option value="feminino">Feminino</option>
                                    <option value="todos">N/A</option>
                                </select>
                            </label>
                        </fieldset>

                        <fieldset class="campo-imagem">
                            <legend><strong class="label-titulo">Imagem do Produto</strong></legend>
                            <label for="imagem-add" class="label-arquivo">
                                <input type="file" id="imagem-add" name="imagem"
                                    accept="image/svg+xml,image/png,image/jpeg,image/webp"
                                    aria-describedby="imagem-add-info">
                                <output id="imagem-add-info" class="info-arquivo">Formatos aceitos: SVG, PNG, JPG, WEBP (máx. 5MB)</output>
                            </label>
                            <div id="preview-imagem-add" class="preview-container" role="status" aria-live="polite"></div>
                        </fieldset>

                        <fieldset>
                            <legend class="label-titulo">Descrição do Produto <span class="obrigatorio" aria-hidden="true">*</span></legend>
                            <label for="descricao-add">
                                <textarea id="descricao-add" name="descricao" placeholder="Digite a descrição do produto" rows="5" required aria-required="true"></textarea>
                            </label>
                        </fieldset>

                        <button type="submit" class="btn-adicionar">Adicionar Produto</button>
                    </form>
                </section>
            </section>

            <%# produtos %>
            <section class="tab-content" id="tab-produtos" role="tabpanel" aria-labelledby="titulo-lista">
                <section class="lista-produtos">
                    <h2 id="titulo-lista" class="subtitulo">Produtos Cadastrados</h2>

                    <% if (produtos.length === 0) { %>
                        <output class="mensagem-vazia">Nenhum produto cadastrado ainda.</output>
                    <% } else { %>
                        <ul class="produtos-lista" role="list">
                            <% produtos.forEach(function(produto) { %>
                                <li class="produto-item" role="listitem">
                                    <article class="produto-info-container">
                                        <figure>
                                            <h3 class="produto-nome"><%= produto.nome %></h3>
                                            <figcaption class="produto-info">ID: <%= produto.id %></figcaption>
                                        </figure>
                                        <output class="produto-info">Categorias: <%= produto.categoria || 'Sem categoria' %></output>
                                        <output class="produto-info produto-preco">R$ <%= produto.preco.toFixed(2) %></output>
                                        <% if (produto.precoDesconto) { %>
                                            <output class="produto-info desconto">Com Desconto: R$ <%= produto.precoDesconto.toFixed(2) %></output>
                                        <% } %>
                                        <output class="produto-info <%= produto.status === 'em-estoque' ? '' : 'desconto' %>">
                                            Status: <%= produto.status === 'em-estoque' ? 'Em Estoque' : 'Fora de Estoque' %>
                                        </output>
                                    </article>
                                    <nav class="acoes-produto" aria-label="Ações do produto <%= produto.nome %>">
                                        <a href="/admin/editar-produto/<%= produto.id %>" class="btn-editar" aria-label="Editar produto <%= produto.nome %>">Editar</a>
                                        <form method="POST" action="/admin/excluir-produto/<%= produto.id %>" class="form-inline"
                                              data-confirmar="Tem certeza que deseja excluir este produto?">
                                            <button class="btn-excluir" type="submit"
                                                    aria-label="Excluir produto <%= produto.nome %>">Excluir</button>
                                        </form>
                                    </nav>
                                </li>
                            <% }); %>
                        </ul>
                    <% } %>
                </section>
            </section>

            <%# categorias%>
            <section class="tab-content" id="tab-categorias" role="tabpanel" aria-labelledby="titulo-categorias">
                <section class="lista-categorias-section">
                    <h2 id="titulo-categorias" class="subtitulo">Gerenciar Categorias</h2>

                    <section class="adicionar-categoria">
                        <h3 class="subtitulo subtitulo-secundario">Criar Nova Categoria</h3>
                        <form method="POST" action="/admin/criar-categoria" class="form-produto" aria-label="Formulário de criação de categoria">
                            <fieldset>
                                <legend class="label-titulo">Nome da Categoria <span class="obrigatorio" aria-hidden="true">*</span></legend>
                                <label for="nome_categoria">
                                    <input type="text" id="nome_categoria" name="nome_categoria"
                                           placeholder="Ex: Medicamentos, Bebê, Dermocosméticos..."
                                           required aria-required="true" minlength="2" maxlength="60">
                                </label>
                            </fieldset>
                            <fieldset>
                                <legend class="label-titulo">Faixa Etária da Categoria (opcional)</legend>
                                <label for="faixa_etaria_categoria">
                                    <select id="faixa_etaria_categoria" name="faixa_etaria_categoria">
                                        <option value="">Todas as idades</option>
                                        <option value="40+">A partir de 40 anos</option>
                                        <option value="45+">A partir de 45 anos</option>
                                        <option value="50+">A partir de 50 anos</option>
                                        <option value="55+">A partir de 55 anos</option>
                                        <option value="60+">A partir de 60 anos</option>
                                        <option value="65+">A partir de 65 anos</option>
                                        <option value="70+">A partir de 70 anos</option>
                                        <option value="75+">A partir de 75 anos</option>
                                        <option value="80+">80 anos ou mais</option>
                                    </select>
                                </label>
                            </fieldset>
                            <fieldset>
                                <legend class="label-titulo">Público-Alvo (Sexo) da Categoria</legend>
                                <label for="sexo-nova-categoria">
                                    <select id="sexo-nova-categoria" name="sexo_categoria">
                                        <option value="masculino">Masculino</option>
                                        <option value="feminino">Feminino</option>
                                        <option value="todos">N/A</option>
                                    </select>
                                </label>
                            </fieldset>
                            <button type="submit" class="btn-adicionar">Criar Categoria</button>
                        </form>
                    </section>

                    <% if (categorias && categorias.length > 0) { %>
                        <ul class="usuarios-lista lista-apos-formulario" role="list">
                            <% categorias.forEach(function(cat) { %>
                                <li class="usuario-item" role="listitem">
                                    <article class="usuario-info-container">
                                        <figure>
                                            <h3 class="usuario-email"><%= cat.nome %></h3>
                                            <figcaption class="usuario-info">Slug: /categoria/<%= cat.slug %></figcaption>
                                            <output class="usuario-info">
                                                Faixa etária: <%= cat.faixa_etaria || 'Todas as idades' %>
                                            </output>
                                            <output class="usuario-info">
                                                Público: <%= cat.sexo || 'Todos' %>
                                            </output>
                                        </figure>
                                    </article>
                                    <nav class="acoes-usuario acoes-categoria" aria-label="Ações da categoria <%= cat.nome %>">
                                        <form method="POST"
                                              action="/admin/atualizar-faixa-categoria/<%= cat.id_categoria %>"
                                              class="form-categoria"
                                              aria-label="Atualizar faixa etária e público de <%= cat.nome %>">
                                            <fieldset class="campo-categoria">
                                                <legend class="visually-hidden">Faixa etária</legend>
                                                <label for="faixa-cat-<%= cat.id_categoria %>" class="visually-hidden">
                                                    Faixa etária de <%= cat.nome %>
                                                </label>
                                                <select id="faixa-cat-<%= cat.id_categoria %>" name="faixa_etaria">
                                                    <option value=""  <%= !cat.faixa_etaria ? 'selected' : '' %>>Todas as idades</option>
                                                    <option value="40+" <%= cat.faixa_etaria === '40+' ? 'selected' : '' %>>40+</option>
                                                    <option value="45+" <%= cat.faixa_etaria === '45+' ? 'selected' : '' %>>45+</option>
                                                    <option value="50+" <%= cat.faixa_etaria === '50+' ? 'selected' : '' %>>50+</option>
                                                    <option value="55+" <%= cat.faixa_etaria === '55+' ? 'selected' : '' %>>55+</option>
                                                    <option value="60+" <%= cat.faixa_etaria === '60+' ? 'selected' : '' %>>60+</option>
                                                    <option value="65+" <%= cat.faixa_etaria === '65+' ? 'selected' : '' %>>65+</option>
                                                    <option value="70+" <%= cat.faixa_etaria === '70+' ? 'selected' : '' %>>70+</option>
                                                    <option value="75+" <%= cat.faixa_etaria === '75+' ? 'selected' : '' %>>75+</option>
                                                    <option value="80+" <%= cat.faixa_etaria === '80+' ? 'selected' : '' %>>80+</option>
                                                </select>
                                            </fieldset>
                                            <fieldset class="campo-categoria">
                                                <legend class="visually-hidden">Público-alvo (sexo)</legend>
                                                <label for="sexo_cat_<%= cat.id_categoria %>" class="visually-hidden">
                                                    Público-alvo de <%= cat.nome %>
                                                </label>
                                                <select id="sexo_cat_<%= cat.id_categoria %>" name="sexo">
                                                    <option value="masculino" <%= cat.sexo === 'masculino' ? 'selected' : '' %>>Masculino</option>
                                                    <option value="feminino"  <%= cat.sexo === 'feminino'  ? 'selected' : '' %>>Feminino</option>
                                                    <option value="todos"     <%= (!cat.sexo || cat.sexo === 'todos') ? 'selected' : '' %>>N/A</option>
                                                </select>
                                            </fieldset>
                                            <button type="submit" class="btn-editar"
                                                    aria-label="Salvar faixa etária e público de <%= cat.nome %>">Salvar</button>
                                        </form>
                                        <a href="/categoria/<%= cat.slug %>" class="btn-editar" target="_blank" rel="noopener noreferrer"
                                           aria-label="Ver página da categoria <%= cat.nome %>">Ver Página</a>
                                        <form method="POST" action="/admin/excluir-categoria/<%= cat.id_categoria %>" class="form-inline"
                                              data-confirmar="Excluir a categoria “<%= cat.nome %>”? Produtos vinculados perderão esta categoria.">
                                            <button class="btn-excluir" type="submit"
                                                aria-label="Excluir categoria <%= cat.nome %>">Excluir</button>
                                        </form>
                                    </nav>
                                </li>
                            <% }); %>
                        </ul>
                    <% } else { %>
                        <output class="mensagem-vazia">Nenhuma categoria cadastrada ainda.</output>
                    <% } %>
                </section>
            </section>

            <%# usuarios %>
            <section class="tab-content" id="tab-usuarios" role="tabpanel" aria-labelledby="titulo-usuarios">
                <section class="lista-usuarios-section">
                    <h2 id="titulo-usuarios" class="subtitulo">Usuários Cadastrados</h2>

                    <% if (usuarios.length === 0) { %>
                        <output class="mensagem-vazia">Nenhum usuário cadastrado ainda.</output>
                    <% } else { %>
                        <ul class="usuarios-lista" role="list">
                            <% usuarios.forEach(function(usuario) { %>
                                <li class="usuario-item" role="listitem">
                                    <article class="usuario-info-container">
                                        <figure>
                                            <h3 class="usuario-email"><%= usuario.email %></h3>
                                            <figcaption class="usuario-info">Nome: <%= usuario.nome %></figcaption>
                                        </figure>
                                        <output class="usuario-info">CPF: <%= usuario.cpf %></output>
                                        <output class="usuario-info">Telefone: (<%= usuario.ddd || '00' %>) <%= usuario.tel %></output>
                                        <time class="usuario-info" datetime="<%= isoData(usuario.nasc) %>">
                                            Nascimento: <%= new Date(usuario.nasc).toLocaleDateString('pt-BR') %>
                                        </time>
                                        <output class="usuario-info">
                                            Pedidos realizados: <%= usuario.total_pedidos %>
                                        </output>
                                    </article>
                                    <nav class="acoes-usuario" aria-label="Ações do usuário <%= usuario.email %>">
                                        <a href="/admin/usuario/<%= encodeURIComponent(usuario.email) %>"
                                           class="btn-editar"
                                           aria-label="Ver conta de <%= usuario.email %>">Ver Conta</a>
                                        <form method="POST" action="/admin/excluir-usuario/<%= encodeURIComponent(usuario.email) %>" class="form-inline"
                                              data-confirmar="Tem certeza que deseja excluir este usuário?">
                                            <button class="btn-excluir" type="submit"
                                                    aria-label="Excluir usuário <%= usuario.email %>">Excluir</button>
                                        </form>
                                    </nav>
                                </li>
                            <% }); %>
                        </ul>
                    <% } %>
                </section>
            </section>

            <%# banners %>
            <section class="tab-content" id="tab-banners" role="tabpanel" aria-labelledby="titulo-banners">
                <section class="lista-banners-section">
                    <h2 id="titulo-banners" class="subtitulo">Gerenciar Banners de Destaque</h2>  <%# [ALTERADO] era "...do Carrossel" %>

                    <%# --- Formulário de criar novo banner --- %>
                    <section class="adicionar-categoria adicionar-banner">
                        <h3 class="subtitulo subtitulo-secundario">Adicionar Novo Banner</h3>
                        <form method="POST" action="/admin/criar-banner" class="form-produto" enctype="multipart/form-data" aria-label="Formulário de criação de banner">
                            <fieldset>
                                <legend class="label-titulo">Legenda do Banner <span class="obrigatorio" aria-hidden="true">*</span></legend>
                                <label for="legenda-novo-banner">
                                    <input type="text" id="legenda-novo-banner" name="legenda"
                                           placeholder="Ex: Promoções de Verão"
                                           required aria-required="true" maxlength="150"
                                           aria-describedby="legenda-novo-info">
                                </label>
                                <output id="legenda-novo-info" class="info-arquivo">A legenda aparece sobreposta na imagem do banner.</output>
                            </fieldset>

                            <fieldset>
                                <legend class="label-titulo">Link de Destino</legend>
                                <label for="link-novo-banner">
                                    <input type="text" id="link-novo-banner" name="link"
                                           placeholder="/home ou /categoria/nome-da-categoria"
                                           maxlength="200" aria-describedby="link-novo-info">
                                </label>
                                <output id="link-novo-info" class="info-arquivo">Exemplos: /home, /categoria/cuidados-com-a-pele, /produto/123</output>
                            </fieldset>

                            <%# [NOVO] faixa etária e sexo: alimentam o algoritmo de relevância ("Para Você") %>
                            <fieldset>
                                <legend class="label-titulo">Faixa Etária Recomendada</legend>
                                <label for="faixa-etaria-novo-banner">
                                    <select id="faixa-etaria-novo-banner" name="faixa_etaria">
                                        <option value="">Todas as idades</option>
                                        <option value="40+">A partir de 40 anos</option>
                                        <option value="45+">A partir de 45 anos</option>
                                        <option value="50+">A partir de 50 anos</option>
                                        <option value="55+">A partir de 55 anos</option>
                                        <option value="60+">A partir de 60 anos</option>
                                        <option value="65+">A partir de 65 anos</option>
                                        <option value="70+">A partir de 70 anos</option>
                                        <option value="75+">A partir de 75 anos</option>
                                        <option value="80+">80 anos ou mais</option>
                                    </select>
                                </label>
                            </fieldset>

                            <fieldset>
                                <legend class="label-titulo">Público-Alvo (Sexo)</legend>
                                <label for="sexo-novo-banner">
                                    <select id="sexo-novo-banner" name="sexo">
                                        <option value="todos">N/A</option>
                                        <option value="masculino">Masculino</option>
                                        <option value="feminino">Feminino</option>
                                    </select>
                                </label>
                            </fieldset>

                            <fieldset class="campo-imagem">
                                <legend><strong class="label-titulo">Imagem do Banner <span class="obrigatorio" aria-hidden="true">*</span></strong></legend>
                                <label for="imagem-novo-banner" class="label-arquivo">
                                    <input type="file" id="imagem-novo-banner" name="imagem"
                                        accept="image/svg+xml,image/png,image/jpeg,image/webp"
                                        required aria-required="true"
                                        aria-describedby="imagem-novo-info">
                                    <output id="imagem-novo-info" class="info-arquivo">Formatos aceitos: SVG, PNG, JPG, WEBP (máx. 5MB). Recomendado: proporção 16:9.</output>
                                </label>
                                <div id="preview-novo-banner" class="preview-container" role="status" aria-live="polite"></div>
                            </fieldset>

                            <button type="submit" class="btn-adicionar">Adicionar Banner</button>
                        </form>
                    </section>

                    <%# --- Lista de banners existentes --- %>
                    <h3 class="subtitulo subtitulo-secundario">Banners Existentes</h3>

                    <output class="mensagem-info" role="status">
                        Edite ou exclua os banners de destaque da página inicial. A home mostra 3 banners no desktop e 2 no mobile, escolhidos pelo mesmo critério de relevância da faixa "Para Você".  <%# [ALTERADO] texto %>
                    </output>

                    <% if (typeof banners !== 'undefined' && banners && banners.length > 0) { %>
                        <ul class="usuarios-lista" role="list">
                            <% banners.forEach(function(banner, index) { %>
                                <li class="usuario-item" role="listitem">
                                    <article class="usuario-info-container">
                                        <figure>
                                            <img src="<%= banner.imagem %>" alt="<%= banner.legenda %>">
                                            <figcaption class="usuario-info">Banner <%= index + 1 %></figcaption>
                                        </figure>
                                        <output class="usuario-info">Legenda: <%= banner.legenda %></output>
                                        <output class="usuario-info">Link: <%= banner.link || '/home' %></output>
                                        <%# [NOVO] público-alvo do banner %>
                                        <output class="usuario-info">Faixa etária: <%= banner.faixa_etaria || 'Todas as idades' %></output>
                                        <output class="usuario-info">Público: <%= banner.sexo === 'masculino' ? 'Masculino' : (banner.sexo === 'feminino' ? 'Feminino' : 'N/A') %></output>
                                    </article>
                                    <nav class="acoes-usuario" aria-label="Ações do banner <%= index + 1 %>">
                                        <button class="btn-editar" type="button"
                                                data-banner-id="<%= banner.id_banner %>"
                                                data-banner-legenda="<%= banner.legenda %>"
                                                data-banner-link="<%= banner.link || '/home' %>"
                                                data-banner-faixa="<%= banner.faixa_etaria || '' %>"
                                                data-banner-sexo="<%= banner.sexo || 'todos' %>"
                                                aria-label="Editar banner <%= index + 1 %>">Editar</button>
                                        <form method="POST" action="/admin/excluir-banner/<%= banner.id_banner %>" class="form-inline"
                                              data-confirmar="Tem certeza que deseja excluir este banner?">
                                            <button class="btn-excluir" type="submit"
                                                    aria-label="Excluir banner <%= index + 1 %>">Excluir</button>
                                        </form>
                                    </nav>
                                </li>
                            <% }); %>
                        </ul>
                    <% } else { %>
                        <output class="mensagem-vazia">Nenhum banner cadastrado ainda. Adicione um acima!</output>
                    <% } %>
                </section>
            </section>
        </section>
    </main>
 
    <footer>
        <nav class="rodape-admin" aria-label="Navegação do rodapé">
            <a href="/home" class="btn-adicionar">Voltar ao Site</a>
            <a href="/logout" class="btn-excluir">Sair da Conta de Administrador</a>
        </nav>
    </footer>

    <%# Modal de edição de banner %>
    <dialog id="modal-banner" class="modal-dialogo" aria-labelledby="modal-titulo">
        <article class="modal-content">
            <h2 class="subtitulo" id="modal-titulo">Editar Banner de Destaque</h2>  <%# [ALTERADO] era "...do Carrossel" %>
            <form method="POST" id="form-editar-banner" enctype="multipart/form-data" class="form-produto" aria-label="Formulário de edição de banner">
                <fieldset>
                    <legend class="label-titulo">Legenda do Banner</legend>
                    <label for="legenda-banner">
                        <input type="text" id="legenda-banner" name="legenda"
                               placeholder="Ex: Promoções Especiais" required aria-required="true"
                               maxlength="150" aria-describedby="legenda-info">
                    </label>
                    <output id="legenda-info" class="info-arquivo">A legenda aparecerá sobreposta na imagem do banner.</output>
                </fieldset>

                <fieldset>
                    <legend class="label-titulo">Link de Destino</legend>
                    <label for="link-banner">
                        <input type="text" id="link-banner" name="link"
                               placeholder="/home ou /categoria/nome" required aria-required="true"
                               maxlength="200" aria-describedby="link-info">
                    </label>
                    <output id="link-info" class="info-arquivo">Exemplos: /home, /categoria/cuidados-com-a-pele, /produto/123</output>
                </fieldset>

                <%# [NOVO] faixa etária e sexo no modal de edição (preenchidos em abrirModal) %>
                <fieldset>
                    <legend class="label-titulo">Faixa Etária Recomendada</legend>
                    <label for="faixa-banner">
                        <select id="faixa-banner" name="faixa_etaria">
                            <option value="">Todas as idades</option>
                            <option value="40+">A partir de 40 anos</option>
                            <option value="45+">A partir de 45 anos</option>
                            <option value="50+">A partir de 50 anos</option>
                            <option value="55+">A partir de 55 anos</option>
                            <option value="60+">A partir de 60 anos</option>
                            <option value="65+">A partir de 65 anos</option>
                            <option value="70+">A partir de 70 anos</option>
                            <option value="75+">A partir de 75 anos</option>
                            <option value="80+">80 anos ou mais</option>
                        </select>
                    </label>
                </fieldset>

                <fieldset>
                    <legend class="label-titulo">Público-Alvo (Sexo)</legend>
                    <label for="sexo-banner">
                        <select id="sexo-banner" name="sexo">
                            <option value="todos">N/A</option>
                            <option value="masculino">Masculino</option>
                            <option value="feminino">Feminino</option>
                        </select>
                    </label>
                </fieldset>

                <fieldset class="campo-imagem">
                    <legend><strong class="label-titulo">Nova Imagem (opcional)</strong></legend>
                    <label for="imagem-banner" class="label-arquivo">
                        <input type="file" id="imagem-banner" name="imagem"
                            accept="image/svg+xml,image/png,image/jpeg,image/webp"
                            aria-describedby="banner-info">
                        <output id="banner-info" class="info-arquivo">
                            Formatos aceitos: SVG, PNG, JPG, WEBP (máx. 5MB). Deixe em branco para manter a imagem atual.
                        </output>
                    </label>
                    <div id="preview-banner" class="preview-container" role="status" aria-live="polite"></div>
                </fieldset>

                <button type="submit" class="btn-adicionar">Salvar Alterações do Banner</button>
                <button type="button" class="btn-adicionar btn-cancelar" id="btn-fechar-modal">Cancelar</button>
            </form>
        </article>
    </dialog>

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // confirmação de exclusão (texto em data-confirmar, sem JS dentro do atributo)
            document.addEventListener('submit', function(e) {
                var mensagem = e.target.getAttribute && e.target.getAttribute('data-confirmar');
                if (mensagem && !window.confirm(mensagem)) e.preventDefault();
            });

            // tabs
            var tabsHeader  = document.querySelector('.tabs-header');
            var tabButtons  = Array.prototype.slice.call(document.querySelectorAll('.tab-button'));
            var tabContents = Array.prototype.slice.call(document.querySelectorAll('.tab-content'));

            function existeTab(tabId) {
                return tabButtons.some(function(btn) { return btn.getAttribute('data-tab') === tabId; })
                    && !!document.getElementById('tab-' + tabId);
            }

            function ativarTab(tabId, focar) {
                if (!existeTab(tabId)) return;
                tabButtons.forEach(function(btn) {
                    var ativo = btn.getAttribute('data-tab') === tabId;
                    btn.classList.toggle('active', ativo);
                    btn.setAttribute('aria-selected', ativo ? 'true' : 'false');
                    btn.setAttribute('tabindex', ativo ? '0' : '-1');
                    if (ativo && focar) btn.focus();
                });
                tabContents.forEach(function(content) {
                    content.classList.toggle('active', content.id === 'tab-' + tabId);
                });
            }

            tabButtons.forEach(function(button) {
                button.addEventListener('click', function() {
                    ativarTab(this.getAttribute('data-tab'));
                });
            });

            // navegação por teclado entre as abas (setas, Home e End)
            tabsHeader.addEventListener('keydown', function(e) {
                var atual = tabButtons.indexOf(document.activeElement);
                if (atual < 0) return;
                var proxima;
                if (e.key === 'ArrowRight')     proxima = (atual + 1) % tabButtons.length;
                else if (e.key === 'ArrowLeft') proxima = (atual - 1 + tabButtons.length) % tabButtons.length;
                else if (e.key === 'Home')      proxima = 0;
                else if (e.key === 'End')       proxima = tabButtons.length - 1;
                else return;
                e.preventDefault();
                ativarTab(tabButtons[proxima].getAttribute('data-tab'), true);
            });

            // aba inicial: ?tab=... quando válida; caso contrário, a primeira
            var tabParam = new URLSearchParams(window.location.search).get('tab');
            ativarTab(existeTab(tabParam) ? tabParam : tabButtons[0].getAttribute('data-tab'));

            // preview da imagem
            function marcarInfo(info, texto, tipo) {
                if (!info) return;
                info.textContent = texto;
                info.classList.remove('info-ok', 'info-erro');
                if (tipo) info.classList.add('info-' + tipo);
            }

            function setupPreview(inputId, previewId, infoId, tiposAceitos) {
                var input   = document.getElementById(inputId);
                var preview = document.getElementById(previewId);
                var info    = infoId ? document.getElementById(infoId) : null;
                if (!input || !preview) return;

                input.addEventListener('change', function(e) {
                    var arquivo = e.target.files[0];
                    if (!arquivo) { preview.innerHTML = ''; return; }

                    if (arquivo.size > 5 * 1024 * 1024) {
                        marcarInfo(info, 'Erro: máximo 5MB', 'erro');
                        preview.innerHTML = ''; input.value = ''; return;
                    }
                    if (!tiposAceitos.includes(arquivo.type)) {
                        marcarInfo(info, 'Erro: formato não permitido', 'erro');
                        preview.innerHTML = ''; input.value = ''; return;
                    }
                    var reader = new FileReader();
                    reader.onload = function(ev) {
                        var fig = document.createElement('figure');
                        fig.className = 'preview-figure';
                        var img = document.createElement('img');
                        img.src = ev.target.result; img.alt = 'Preview'; img.className = 'preview-img';
                        var cap = document.createElement('figcaption');
                        cap.textContent = arquivo.name; cap.className = 'preview-caption';
                        fig.appendChild(img); fig.appendChild(cap);
                        preview.innerHTML = ''; preview.appendChild(fig);
                        marcarInfo(info, 'Imagem selecionada!', 'ok');
                    };
                    reader.readAsDataURL(arquivo);
                });
            }

            var tiposImagem = ['image/svg+xml', 'image/png', 'image/jpeg', 'image/webp'];
            setupPreview('imagem-add',         'preview-imagem-add',  'imagem-add-info',  tiposImagem);
            setupPreview('imagem-novo-banner', 'preview-novo-banner', 'imagem-novo-info', tiposImagem);
            setupPreview('imagem-banner',      'preview-banner',      'banner-info',      tiposImagem);

            // edição de banner (<dialog>: foco, Esc e fundo inerte são nativos)
            var modal        = document.getElementById('modal-banner');
            var form         = document.getElementById('form-editar-banner');
            var btnFechar    = document.getElementById('btn-fechar-modal');
            var inputLegenda = document.getElementById('legenda-banner');
            var inputLink    = document.getElementById('link-banner');
            var selectFaixa  = document.getElementById('faixa-banner');
            var selectSexo   = document.getElementById('sexo-banner');

            function abrirModal(bannerId, legenda, link, faixa, sexo) {
                form.action = '/admin/editar-banner/' + bannerId;
                inputLegenda.value = legenda || '';
                inputLink.value    = link    || '/home';
                selectFaixa.value  = faixa   || '';
                selectSexo.value   = sexo    || 'todos';
                document.getElementById('imagem-banner').value = '';
                document.getElementById('preview-banner').innerHTML = '';
                modal.showModal();
                document.body.style.overflow = 'hidden';
                inputLegenda.focus();
            }

            // roda ao fechar por qualquer meio (botão, Esc, clique no fundo)
            modal.addEventListener('close', function() {
                form.reset();
                document.getElementById('preview-banner').innerHTML = '';
                document.body.style.overflow = '';
            });

            document.querySelectorAll('[data-banner-id]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    abrirModal(
                        this.getAttribute('data-banner-id'),
                        this.getAttribute('data-banner-legenda'),
                        this.getAttribute('data-banner-link'),
                        this.getAttribute('data-banner-faixa'),
                        this.getAttribute('data-banner-sexo')
                    );
                });
            });

            btnFechar.addEventListener('click', function() { modal.close(); });
            modal.addEventListener('click', function(e) { if (e.target === modal) modal.close(); });
        });
    </script>
</body>
</html>