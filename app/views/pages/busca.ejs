<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Busca: <%= termo %> - +Saúde</title>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/grid.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/categoria.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>
    <link rel="stylesheet" href="/css/acessibilidade-idosos.css">
    <script src="/js/acessibilidade-idosos.js"></script>
</head>
<body>
    <header>
        <%- include('../partial/grid.ejs') %>
    </header>

    <%- include('../partial/ajuste-texto.ejs') %>

    <main>
        <nav class="navegacao" aria-label="Navegação de retorno">
            <a href="/home" class="voltar">
                <img src="/imagens/setae.svg" alt="" class="seta-voltar">
                <span>Voltar</span>
            </a>
        </nav>

        <section class="categoria-container">
            <h1 class="titulo-categoria">
                Resultados para: "<%= termo %>"
            </h1>

            <% if (produtos.length === 0) { %>
                <article class="categoria-vazia">
                    <p class="mensagem-vazio">Não encontramos nenhum produto para "<%= termo %>".</p>
                    <p class="dica-busca">Confira se escreveu certinho ou tente uma palavra mais simples, como o nome do remédio ou da categoria.</p>
                    <a href="/home" class="btn-voltar-home">Voltar para o início</a>
                </article>
            <% } else { %>
                <p class="resultado-contagem" role="status">
                    <%= produtos.length %> produto<%= produtos.length !== 1 ? 's' : '' %> encontrado<%= produtos.length !== 1 ? 's' : '' %>
                </p>
                <section class="produtos-container">
                    <% produtos.forEach(function(produto) {
                        var precoAtual = produto.preco || 0;
                        var precoComDesconto = produto.precoDesconto || null;
                        var temDesconto = precoComDesconto !== null && precoComDesconto > 0;
                        var percentualDesconto = 0;
                        if (temDesconto && precoAtual > 0) {
                            percentualDesconto = Math.round(((precoAtual - precoComDesconto) / precoAtual) * 100);
                        }
                    %>
                        <article class="bloco-produto-home">
                            <a href="/produto/<%= produto.id %>" class="link-produto-home">
                                <img src="<%= produto.imagem %>" alt="<%= produto.nome %>" class="imagem-produto-home">

                                <h2 class="nome-produto-home"><%= produto.nome %></h2>

                                <% if (temDesconto) { %>
                                    <section class="preco-container-home">
                                        <span class="sr-only">Preço original: </span><span class="preco-original-home">R$ <%= precoAtual.toFixed(2) %></span>
                                        <span class="sr-only">Preço com desconto: </span><span class="preco-desconto-home">R$ <%= precoComDesconto.toFixed(2) %></span>
                                        <span class="badge-desconto">
                                            <span class="percentual-home">-<%= percentualDesconto %>%</span>
                                        </aside>
                                    </section>
                                <% } else { %>
                                    <span class="preco-unico-home">R$ <%= precoAtual.toFixed(2) %></span>
                                <% } %>

                                <span class="categoria-home"><%= produto.categoria || '' %></span>
                            </a>
                        </article>
                    <% }); %>
                </section>
            <% } %>
        </section>
    </main>

    <%- include('../partial/footer.ejs') %>
</body>
</html>
